/* ======================
   全局样式：所有组件的基础样式
====================== */

/* 主窗口背景色：浅灰色 */
QMainWindow {
    background: #f5f7fb;
}

QWidget {
    font-family: "Microsoft YaHei";
    font-size: 14px;
    color: #222;
}

/* ======================
   Sidebar（侧边栏）样式
   使用 # 选择器精确匹配 objectName
====================== */

#Sidebar {
    background: white;
    border-right: 1px solid #e5e7eb;
}

#SidebarTitle {
    font-size: 22px;
    font-weight: bold;
    padding: 20px;
}

/* ======================
   页面标题样式
====================== */

#PageTitle {
    font-size: 30px;
    font-weight: bold;
    padding: 10px 0;
}

/* ======================
   输入框样式
====================== */

QLineEdit {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 14px;
    padding: 12px 15px;
    font-size: 15px;
}

QLineEdit:focus {
    border: 2px solid #6366f1;
}

QLineEdit::selection {
    background: #6366f1;
    color: white;
}

/* ======================
   普通按钮
====================== */

QPushButton {
    background: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 10px 15px;
}

QPushButton:hover {
    background: #eef2ff;
}

QPushButton:pressed {
    background: #e0e7ff;
}

/* ======================
   添加按钮
====================== */

#AddButton {
    background: #4f46e5;
    color: white;
    font-weight: bold;
}

#AddButton:hover {
    background: #6366f1;
}

#AddButton:pressed {
    background: #4338ca;
}

QCheckBox {
    width: 22px;
    height: 22px;
}

/* ======================
   TaskCard 内的按钮
====================== */
#TaskCard {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    padding: 10px;
}

#TaskCard:hover {
    background: #fafafa;
    border: 1px solid #818cf8;
}

#TaskCard QCheckBox {
    width:18px;
    height:18px;
}

#TaskCard QPushButton {
    border: none;
    background: transparent;
    padding: 5px;
    border-radius: 8px;
    font-size: 16px;
}

/* 编辑按钮 */
#TaskCard #EditButton:hover {
    background:#dbeafe;
}

/* 删除按钮 */
#TaskCard #DeleteButton:hover {
    background:#fee2e2;
}

#TaskCard #EditButton:pressed {
    background:#bfdbfe;
}

#TaskCard #DeleteButton:pressed {
    background:#fecaca;
}

#TaskCard QLabel {
    font-size:13px;
}

/* ======================
   任务容器样式
====================== */

#TaskContainer {
    background: #f8f9fc;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

/* ======================
   滚动条样式
====================== */

QScrollArea {
    border: none;
    background: transparent;
}

/* 垂直滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

/* 滚动条滑块 */
QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 3px;
    min-height: 30px;
}

/* 滚动条滑块悬停 */
QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

/* 隐藏滚动条两端的箭头按钮 */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 滚动条轨道背景透明 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ======================
   Footer
====================== */

#Footer {
    background: transparent;
}

/* ======================
   GitHub / Bilibili 图标按钮
====================== */

#GitHubButton,
#BilibiliButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}

/* GitHub hover */
#GitHubButton:hover {
    background: #eef2ff;
}

/* Bilibili hover */
#BilibiliButton:hover {
    background: #fee2e2;
}

#GitHubButton:pressed,
#BilibiliButton:pressed {
    background: #c7d2fe;
}

/* ======================
   版权信息
====================== */

#CopyrightLabel {
    color: #9ca3af;
    font-size: 12px;
    background: transparent;
}

QComboBox,
QDateEdit,
QLineEdit {
    border:1px solid #d1d5db;
    border-radius:8px;
    padding:7px 10px;
    background:white;
    font-size:14px;
}

QComboBox:hover,
QDateEdit:hover,
QLineEdit:hover {
    border:1px solid #818cf8;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border:none;
    width:28px;
}

#ErrorLabel {
    color:#dc2626;
    font-size:12px;
}

QComboBox,
QDateEdit {
    border:1px solid #d1d5db;
    border-radius:10px;
    padding:8px 12px;
    background:white;
    font-size:15px;
}

QComboBox:hover,
QDateEdit:hover {
    border:1px solid #818cf8;
    background:#fafafa;
}

QComboBox:focus,
QDateEdit:focus {
    border:1px solid #6366f1;
}

/* 下拉箭头 */
QComboBox::drop-down,
QDateEdit::drop-down {
    width:35px;
    border:none;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image:url(src/gui/icons/down.png);
    width:12px;
    height:12px;
}

/* 下拉列表 */
QComboBox QAbstractItemView {
    background:white;
    border-radius:12px;
    border:1px solid #e5e7eb;
    padding:5px;
    outline:none;
}

QComboBox QAbstractItemView::item {
    height:35px;
    padding-left:10px;
    border-radius:8px;
    color: #222;
}

QComboBox QAbstractItemView::item:hover {
    background:#eef2ff;
    color: #222;
}

/* 选中的项 */
QComboBox QAbstractItemView::item:selected {
    background: #cecef9;
    color: white;  /* 选中时白色文字 */
}

/* 选中的项（当列表失去焦点时） */
QComboBox QAbstractItemView::item:selected:!active {
    background: #d1d5db;
    color: #222;
}

/* ComboBox 选中文本样式 */
QComboBox::selection {
    background: #6366f1;
    color: white;
}

/* ======================
   DateEdit 选中样式
====================== */

QDateEdit {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 12px;
    background: white;
    font-size: 15px;
}

QDateEdit:focus {
    border: 1px solid #6366f1;
}

/* DateEdit 选中文本样式 */
QDateEdit::selection {
    background: #6366f1;
    color: white;
}

/* ======================
   Search
====================== */
QLineEdit {
    border:1px solid #d1d5db;
    border-radius:12px;
    padding:8px 12px;
    font-size:15px;
    background:white;
}

/* ======================
   Search Button
====================== */
#SearchButton {
    border:none;
    border-radius:18px;
    background:transparent;
    font-size:18px;
}

#SearchButton:hover {
    background:#eef2ff;
}

/* 搜索输入框 */
#SearchInput {
    border:1px solid #d1d5db;
    border-radius:10px;
    padding:6px 10px;
    font-size:14px;
    background:white;
}

#SearchInput:focus {
    border:1px solid #6366f1;
}

/* 搜索按钮 */
#SearchButton {
    border:none;
    border-radius:18px;
    background:transparent;
    font-size:18px;
}

#SearchButton:hover {
    background:#eef2ff;
}

/* 搜索框 */
#SearchInput {
    border:1px solid #d1d5db;
    border-radius:12px;
    padding:6px 10px;
    background:white;
    font-size:14px;
}

#SearchInput:focus {
    border:1px solid #6366f1;
}