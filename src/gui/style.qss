/* ======================
   全局样式：所有组件的基础样式
====================== */

/* 主窗口背景色：浅灰色 */
QMainWindow {
    background: #f5f7fb;
}

QWidget {
    font-family: "Microsoft YaHei";
    font-size: 14px;
    color: #222;
}

/* ======================
   Sidebar（侧边栏）样式
   使用 # 选择器精确匹配 objectName
====================== */

#Sidebar {
    background: white;
    border-right: 1px solid #e5e7eb;
}

#SidebarTitle {
    font-size: 22px;
    font-weight: bold;
    padding: 20px;
}

/* ======================
   页面标题样式
====================== */

#PageTitle {
    font-size: 30px;
    font-weight: bold;
    padding: 10px 0;
}

/* ======================
   输入框样式
====================== */

QLineEdit {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 14px;
    padding: 12px 15px;
    font-size: 15px;
}

QLineEdit:focus {
    border: 2px solid #6366f1;
}

/* ======================
   普通按钮
====================== */

QPushButton {
    background: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 10px 15px;
}

QPushButton:hover {
    background: #eef2ff;
}

QPushButton:pressed {
    background: #e0e7ff;
}

/* ======================
   添加按钮
====================== */

#AddButton {
    background: #4f46e5;
    color: white;
    font-weight: bold;
}

#AddButton:hover {
    background: #6366f1;
}

#AddButton:pressed {
    background: #4338ca;
}

/* ======================
   Task Card
====================== */

#TaskCard {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    padding: 10px;
}

#TaskCard:hover {
    background: #fafafa;
    border: 1px solid #818cf8;
}

/* ======================
   Checkbox
====================== */

QCheckBox {
    width: 22px;
    height: 22px;
}

/* ======================
   TaskCard 内的按钮
====================== */

#TaskCard QPushButton {
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 16px;
}

#TaskCard QPushButton:hover {
    background: #eef2ff;
}

#DeleteButton:hover {
    background: #fee2e2;
}

#EditButton:hover {
    background: #dbeafe;
}

/* ======================
   任务容器样式
====================== */

#TaskContainer {
    background: #f8f9fc;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

/* ======================
   滚动条样式
====================== */

QScrollArea {
    border: none;
    background: transparent;
}

/* 垂直滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

/* 滚动条滑块 */
QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 3px;
    min-height: 30px;
}

/* 滚动条滑块悬停 */
QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

/* 隐藏滚动条两端的箭头按钮 */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 滚动条轨道背景透明 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ======================
   底部信息栏样式
====================== */

#Footer {
    background: white;
    border-top: 1px solid #e5e7eb;
}

/* ======================
   底部信息栏样式
====================== */

#Footer {
    background: white;
    border-top: 1px solid #e5e7eb;
}
/* ======================
   GitHub 超链接样式（带悬停效果）
====================== */

#GitHubLabel {
    background: transparent;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid transparent;
}

#GitHubLabel:hover {
    background: #eef2ff;
    border: 1px solid #c7d2fe;
}


/* ======================
   版权信息样式
====================== */

#CopyrightLabel {
    color: #9ca3af;
    font-size: 12px;
    background: transparent;
}
