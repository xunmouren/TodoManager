QMainWindow {

    background:#f5f5f7;

}


#Sidebar {

    background:white;

    border-right:1px solid #ddd;

}


#SidebarTitle {

    font-size:22px;

    font-weight:bold;

}


#PageTitle {

    font-size:28px;

    font-weight:bold;

}


QPushButton {

    border:none;

    padding:12px;

    border-radius:10px;

    text-align:left;

}


QPushButton:hover {

    background:#e5e7eb;

}


QLineEdit {

    background:white;

    padding:12px;

    border-radius:12px;

    border:1px solid #ddd;

}


#TaskCard {

    background:white;

    border-radius:15px;

    padding:12px;

    border:1px solid #eee;

}