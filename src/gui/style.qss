QMainWindow {

    background:#f5f5f7;

}


QWidget {

    font-family:
    "Microsoft YaHei";

    font-size:14px;

}



Sidebar {

    background:white;

}



#SidebarTitle {

    font-size:22px;

    font-weight:bold;

    padding:20px;

}



#PageTitle {

    font-size:28px;

    font-weight:bold;

}



QPushButton {

    border:none;

    padding:12px;

    text-align:left;

    border-radius:10px;

}



QPushButton:hover {

    background:#e5e7eb;

}



QLineEdit {

    padding:12px;

    border-radius:12px;

    border:1px solid #ddd;

}