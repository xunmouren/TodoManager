/* ======================
   全局样式：所有组件的基础样式
====================== */

/* 主窗口背景色：浅灰色 */
QMainWindow {
    background:#f5f7fb;
}

QWidget {
    font-family:"Microsoft YaHei";
    font-size:14px;
    color:#222;
}

/* ======================
   Sidebar（侧边栏）样式
   使用 # 选择器精确匹配 objectName
====================== */

#Sidebar {
    background:white;
    border-right:1px solid #e5e7eb;
}

#SidebarTitle {
    font-size:22px;
    font-weight:bold;
    padding:20px;
}

/* ======================
   页面标题样式
====================== */

#PageTitle {
    font-size:30px;
    font-weight:bold;
    padding:10px 0;
}

/* ======================
   输入框样式
====================== */

QLineEdit {
    background:white;
    border:1px solid #d1d5db;
    border-radius:14px;
    padding:12px 15px;
    font-size:15px;
}

QLineEdit:focus {
    border:2px solid #6366f1;
}

/* ======================
   普通按钮
====================== */

QPushButton {
    background:#ffffff;
    border:none;
    border-radius:12px;
    padding:10px 15px;
}

QPushButton:hover {
    background:#eef2ff;
}

QPushButton:pressed {
    background:#e0e7ff;
}

/* ======================
   添加按钮
====================== */

#AddButton {
    background:#4f46e5;
    color:white;
    font-weight:bold;
}

#AddButton:hover {
    background:#6366f1;
}

#AddButton:pressed {
    background:#4338ca;
}

/* ======================
   Task Card
====================== */

#TaskCard {
    background:white;
    border-radius:16px;
    border:1px solid #e5e7eb;
    padding:10px;
}

#TaskCard:hover {
    background:#f9fafb;
    border:1px solid #c7d2fe;
}

/* ======================
   Checkbox
====================== */

QCheckBox {
    width:22px;
    height:22px;
}

/* ======================
   删除按钮
====================== */

#TaskCard QPushButton {
    background:transparent;
    border-radius:8px;
    font-size:16px;
}

#TaskCard QPushButton:hover {
    background:#fee2e2;
}

#TaskCard {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

#TaskCard:hover {
    border: 1px solid #818cf8;
    background: #fafafa;
}

#TaskCard QPushButton {
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 16px;
}

#TaskCard QPushButton:hover {
    background: #eef2ff;
}

#DeleteButton:hover {
    background: #fee2e2;
}

#EditButton:hover {
    background: #dbeafe;
}
