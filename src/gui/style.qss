/* =================================================
   TodoManager Theme
   全局样式与组件样式
================================================= */

/* ===== 全局 ===== */
QMainWindow {
    background: #f5f7fb;
}

QWidget {
    font-family: "Microsoft YaHei";
    font-size: 14px;
    color: #222;
}

QDialog {
    background: white;
}

/* ===== Sidebar ===== */
#Sidebar {
    background: white;
    border-right: 1px solid #e5e7eb;
}

#SidebarTitle {
    font-size: 22px;
    font-weight: bold;
    padding: 20px;
}

/* ===== 页面标题 ===== */
#PageTitle {
    font-size: 30px;
    font-weight: bold;
    padding: 10px 0;
}

/* ===== 输入框 ===== */
QLineEdit {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 15px;
}

QLineEdit:focus {
    border: 2px solid #6366f1;
}

QLineEdit::selection {
    background: #6366f1;
    color: white;
}

/* ===== 普通按钮 ===== */
QPushButton {
    background: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 10px 15px;
}

QPushButton:hover {
    background: #eef2ff;
}

QPushButton:pressed {
    background: #e0e7ff;
}

/* ===== 添加按钮 ===== */
#AddButton {
    background: #4f46e5;
    color: white;
    font-weight: bold;
}

#AddButton:hover {
    background: #6366f1;
}

#AddButton:pressed {
    background: #4338ca;
}

/* ===== Checkbox ===== */
QCheckBox {
    width: 22px;
    height: 22px;
}

/* ===== TaskCard ===== */
#TaskCard {
    background: white;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    padding: 10px;
}

#TaskCard:hover {
    background: #fafafa;
    border: 1px solid #818cf8;
}

#TaskCard QCheckBox {
    width: 18px;
    height: 18px;
}

#TaskCard QPushButton {
    border: none;
    background: transparent;
    padding: 5px;
    border-radius: 8px;
    font-size: 16px;
}

#TaskCard QLabel {
    font-size: 13px;
}

/* TaskCard 编辑按钮 */
#TaskCard #EditButton:hover {
    background: #dbeafe;
}

#TaskCard #EditButton:pressed {
    background: #bfdbfe;
}

/* TaskCard 删除按钮 */
#TaskCard #DeleteButton:hover {
    background: #fee2e2;
}

#TaskCard #DeleteButton:pressed {
    background: #fecaca;
}

/* ===== 任务容器 ===== */
#TaskContainer {
    background: #f8f9fc;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

/* ===== 滚动条 ===== */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ===== Footer ===== */
#Footer {
    background: transparent;
}

/* GitHub / Bilibili 图标按钮 */
#GitHubButton,
#BilibiliButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}

#GitHubButton:hover {
    background: #eef2ff;
}

#BilibiliButton:hover {
    background: #fee2e2;
}

#GitHubButton:pressed,
#BilibiliButton:pressed {
    background: #c7d2fe;
}

/* 版权信息 */
#CopyrightLabel {
    color: #9ca3af;
    font-size: 12px;
    background: transparent;
}

/* ===== ComboBox / DateEdit 统一样式 ===== */
QComboBox,
QDateEdit,
QDateTimeEdit {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px 12px;
    background: white;
    font-size: 15px;
}

QComboBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover {
    border: 1px solid #818cf8;
    background: #fafafa;
}

QComboBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #6366f1;
}

QComboBox::drop-down,
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    width: 35px;
    border: none;
}

QComboBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(src/gui/icons/down.png);
    width: 12px;
    height: 12px;
}

/* 下拉列表 */
QComboBox QAbstractItemView {
    background: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 5px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    height: 35px;
    padding-left: 10px;
    border-radius: 8px;
    color: #222;
}

QComboBox QAbstractItemView::item:hover {
    background: #eef2ff;
    color: #222;
}

QComboBox QAbstractItemView::item:selected {
    background: #cecef9;
    color: white;
}

QComboBox QAbstractItemView::item:selected:!active {
    background: #d1d5db;
    color: #222;
}

QComboBox::selection,
QDateEdit::selection,
QDateTimeEdit::selection {
    background: #6366f1;
    color: white;
}

/* ===== 错误提示 ===== */
#ErrorLabel {
    color: #dc2626;
    font-size: 12px;
}

/* ===== 搜索框 ===== */
#SearchInput {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 14px;
    background: white;
}

#SearchInput:focus {
    border: 1px solid #6366f1;
}

/* 搜索按钮 */
#SearchButton {
    border: none;
    border-radius: 18px;
    background: transparent;
    font-size: 18px;
}

#SearchButton:hover {
    background: #eef2ff;
}

/* ===== TaskEditor 对话框 ===== */
#TaskEditor {
    background: white;
    border-radius: 16px;
}

#TaskEditor QLabel {
    color: #374151;
    font-weight: 500;
    font-size: 13px;
}

#TaskEditor QLineEdit,
#TaskEditor QComboBox,
#TaskEditor QDateEdit {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 10px 14px;
    background: white;
    font-size: 14px;
    min-height: 20px;
}

#TaskEditor QLineEdit:focus,
#TaskEditor QComboBox:focus,
#TaskEditor QDateEdit:focus {
    border: 2px solid #6366f1;
}

#TaskEditor QLineEdit::selection,
#TaskEditor QComboBox::selection,
#TaskEditor QDateEdit::selection {
    background: #6366f1;
    color: white;
}

#TaskEditor QComboBox QAbstractItemView {
    background: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 5px;
    outline: none;
}

#TaskEditor QComboBox QAbstractItemView::item {
    height: 35px;
    padding-left: 10px;
    border-radius: 8px;
    color: #222;
}

#TaskEditor QComboBox QAbstractItemView::item:hover {
    background: #eef2ff;
    color: #222;
}

#TaskEditor QComboBox QAbstractItemView::item:selected {
    background: rgba(99, 102, 241, 0.7);
    color: white;
}

#TaskEditor QComboBox QAbstractItemView::item:selected:!active {
    background: #d1d5db;
    color: #222;
}

/* TaskEditor 按钮基础样式 */
#TaskEditor QPushButton {
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 500;
    min-width: 80px;
    border: none;
}

/* 保存按钮 */
#TaskEditor #SaveButton {
    background: #4f46e5;
    color: white;
}

#TaskEditor #SaveButton:hover {
    background: #6366f1;
}

#TaskEditor #SaveButton:pressed {
    background: #4338ca;
}

/* 取消按钮 */
#TaskEditor #CancelButton {
    background: #f3f4f6;
    color: #374151;
}

#TaskEditor #CancelButton:hover {
    background: #e5e7eb;
}

#TaskEditor #CancelButton:pressed {
    background: #d1d5db;
}
