/* =================================================
   Light Theme - 亮色主题
   只包含颜色相关的样式
================================================= */

/* ===== 全局 ===== */
QMainWindow {
    background: #f5f7fb;
}

QWidget {
    color: #222;
}

QDialog {
    background: white;
}

/* ===== Sidebar ===== */
#Sidebar {
    background: white;
    border-right-color: #e5e7eb;
}

#SidebarTitle {
    color: #222;
}

/*  修复：侧边栏按钮白底 */
#Sidebar QPushButton {
    background: white;
    color: #222;
}

#Sidebar QPushButton:hover {
    background: #eef2ff;
}

#Sidebar QPushButton:pressed {
    background: #e0e7ff;
}

/* 分类标题 */
#CategoryTitle {
    color: #6b7280;
    font-size: 13px;
    padding: 8px 15px 4px 15px;
}

/* ===== 输入框 ===== */
QLineEdit {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

QLineEdit:focus {
    border-color: PRIMARY_COLOR;
}

QLineEdit::selection {
    background: PRIMARY_COLOR;
}

/* ===== 普通按钮 ===== */
QPushButton {
    background: #ffffff;
    color: #222;
}

QPushButton:hover {
    background: #eef2ff;
}

QPushButton:pressed {
    background: #e0e7ff;
}

/* ===== 添加按钮 ===== */
#AddButton {
    background: #4f46e5;
    color: white;
}

#AddButton:hover {
    background: PRIMARY_COLOR;
}

#AddButton:pressed {
    background: #4338ca;
}

/* ===== TaskCard ===== */
#TaskCard {
    background: white;
    border: 1px solid #e5e7eb;
}

#TaskCard:hover {
    background: #fafafa;
    border: 1px solid #818cf8;
}

#TaskCard QLabel {
    color: #222;
}

#TaskCard #EditButton:hover {
    background: #dbeafe;
}

#TaskCard #DeleteButton:hover {
    background: #fee2e2;
}

#TaskCard #EditButton:pressed {
    background: #bfdbfe;
}

#TaskCard #DeleteButton:pressed {
    background: #fecaca;
}

/* ===== 任务容器 ===== */
#TaskContainer {
    background: #f8f9fc;
    border: 1px solid #e5e7eb;
}

/* ===== 滚动条 ===== */
QScrollBar::handle:vertical {
    background: #d1d5db;
}

QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

/* ===== Footer ===== */
#Footer {
    background: transparent;
}

#CopyrightLabel {
    color: #9ca3af;
}

#GitHubButton:hover {
    background: #eef2ff;
}

#BilibiliButton:hover {
    background: #fee2e2;
}

#GitHubButton:pressed,
#BilibiliButton:pressed {
    background: #c7d2fe;
}

/* ===== ComboBox / DateEdit ===== */
QComboBox,
QDateEdit,
QDateTimeEdit {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

QComboBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover {
    border: 1px solid #818cf8;
    background: #fafafa;
}

QComboBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid PRIMARY_COLOR;
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #e5e7eb;
}

QComboBox QAbstractItemView::item {
    color: #222;
}

QComboBox QAbstractItemView::item:hover {
    background: #eef2ff;
}

QComboBox QAbstractItemView::item:selected {
    background: #cecef9;
    color: white;
}

QComboBox QAbstractItemView::item:selected:!active {
    background: #d1d5db;
    color: #222;
}

QComboBox::selection,
QDateEdit::selection,
QDateTimeEdit::selection {
    background: PRIMARY_COLOR;
    color: white;
}

/* ===== SpinBox ===== */
QSpinBox {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

QSpinBox:hover {
    border: 1px solid #818cf8;
    background: #fafafa;
}

QSpinBox:focus {
    border: 1px solid PRIMARY_COLOR;
}

/* ===== 错误提示 ===== */
#ErrorLabel {
    color: #dc2626;
}

/* ===== 搜索框 ===== */
#SearchInput {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

#SearchInput:focus {
    border: 1px solid PRIMARY_COLOR;
}

#SearchButton:hover {
    background: #eef2ff;
}

/* ===== TaskEditor ===== */
#TaskEditor {
    background: white;
}

#TaskEditor QLabel {
    color: #374151;
}

#TaskEditor QLineEdit,
#TaskEditor QComboBox,
#TaskEditor QDateEdit {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

#TaskEditor QLineEdit:focus,
#TaskEditor QComboBox:focus,
#TaskEditor QDateEdit:focus {
    border-color: PRIMARY_COLOR;
}

#TaskEditor QLineEdit::selection,
#TaskEditor QComboBox::selection,
#TaskEditor QDateEdit::selection {
    background: PRIMARY_COLOR;
}

#TaskEditor QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #e5e7eb;
}

#TaskEditor QComboBox QAbstractItemView::item {
    color: #222;
}

#TaskEditor QComboBox QAbstractItemView::item:hover {
    background: #eef2ff;
}

#TaskEditor QComboBox QAbstractItemView::item:selected {
    background: rgba(99, 102, 241, 0.7);
    color: white;
}

#TaskEditor QComboBox QAbstractItemView::item:selected:!active {
    background: #d1d5db;
    color: #222;
}

#TaskEditor #SaveButton {
    background: #4f46e5;
    color: white;
}

#TaskEditor #SaveButton:hover {
    background: PRIMARY_COLOR;
}

#TaskEditor #SaveButton:pressed {
    background: #4338ca;
}

#TaskEditor #CancelButton {
    background: #f3f4f6;
    color: #374151;
}

#TaskEditor #CancelButton:hover {
    background: #e5e7eb;
}

#TaskEditor #CancelButton:pressed {
    background: #d1d5db;
}

/* ===== 分类标签 ===== */
#CategoryLabel {
    color: #6366f1;
    background: #eef2ff;
}

/* ===== SettingsPage ===== */
#SettingsPage QSpinBox {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}

#SettingsPage QKeySequenceEdit {
    background: white;
    border: 1px solid #d1d5db;
    color: #222;
}
